# ==============================================================================
# TỆP CẤU HÌNH BIẾN MÔI TRƯỜNG CHATBOT_V1 (ENVIRONMENT VARIABLES)
# ==============================================================================
# HƯỚNG DẪN:
# 1. Sao chép tệp này thành `.env` (chạy: cp .env.example .env)
# 2. Điền các khóa API và cấu hình thật vào các vị trí có chữ YOUR_...
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CẤU HÌNH NHÀ CUNG CẤP AI (LLM & EMBEDDINGS)
# ------------------------------------------------------------------------------
# Lựa chọn 1: Dùng Google Gemini Flash Lite (Hạn mức cao 500 RPD, hỗ trợ danh sách fallback phân cách bằng dấu phẩy)
# - Lấy key tại: https://aistudio.google.com/
LLM_PROVIDER=gemini
LLM_BASE_URL=https://generativelanguage.googleapis.com
LLM_API_KEY=YOUR_GEMINI_API_KEY_HERE
LLM_MODEL=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-2.5-flash-lite
LLM_EMBEDDING_MODEL=gemini-embedding-001,gemini-embedding-002

# Lựa chọn 2: Dùng nhà cung cấp tùy chỉnh hoặc trung gian (Ví dụ: 9router, OpenRouter, Local LLM)
# LLM_PROVIDER=custom_openai
# LLM_BASE_URL=https://api.9router.com/v1
# LLM_API_KEY=YOUR_9ROUTER_API_KEY_HERE
# LLM_MODEL=gemini-1.5-flash

# ------------------------------------------------------------------------------
# 2. CẤU HÌNH TÀI KHOẢN ADMIN (QUẢN LÝ TÀI LIỆU Y VĂN)
# ------------------------------------------------------------------------------
# Khóa bí mật dùng để xác thực quyền Admin khi nạp/xóa tài liệu qua API hoặc giao diện
ADMIN_SECRET_KEY=YOUR_ADMIN_SECRET_PASSWORD_HERE

# ------------------------------------------------------------------------------
# 3. CẤU HÌNH GOOGLE FIREBASE (DÀNH CHO FRONTEND CHATBOT.FE)
# ------------------------------------------------------------------------------
# Lấy các thông số này tại: Firebase Console -> Project Settings -> Your apps -> Web App
VITE_FIREBASE_API_KEY=YOUR_FIREBASE_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=YOUR_PROJECT_ID.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=YOUR_PROJECT_ID
VITE_FIREBASE_STORAGE_BUCKET=YOUR_PROJECT_ID.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=YOUR_MESSAGING_SENDER_ID
VITE_FIREBASE_APP_ID=YOUR_APP_ID
VITE_FIREBASE_MEASUREMENT_ID=YOUR_MEASUREMENT_ID

# ------------------------------------------------------------------------------
# 4. CẤU HÌNH HỆ THỐNG MÁY CHỦ (SERVER & DOCKER COMPOSE)
# ------------------------------------------------------------------------------
PORT=10000
ASPNETCORE_ENVIRONMENT=Production

# Đường dẫn lưu trữ dữ liệu cục bộ khi chạy trực tiếp qua dotnet run:
STORAGE_DOCUMENTS_PATH=src/Chatbot.Be/storage/documents
STORAGE_DB_PATH=src/Chatbot.Be/storage/index/knowledge.db

# Tên Docker Image trên Docker Hub (dùng cho docker-compose kéo image)
DOCKER_IMAGE=YOUR_DOCKERHUB_USERNAME/chatbot_v1:latest

# Lưu ý: Hệ thống sử dụng Docker Named Volumes (chatbot_documents, chatbot_index)
# giúp tự động quản lý và lưu trữ dữ liệu y khoa, không cần tạo thư mục thủ công trên máy chủ VPS.

# ------------------------------------------------------------------------------
# 5. CẤU HÌNH VECTOR DATABASE (QDRANT CLOUD / LOCAL)
# ------------------------------------------------------------------------------
# qdrant: Dùng cụm Qdrant Cloud miễn phí lưu trữ vĩnh viễn (Khuyên dùng khi deploy Render / VPS)
# sqlite: Dùng lưu trữ vector nội bộ trên file SQLite và RAM (Chạy offline local)
VECTOR_STORE_PROVIDER=qdrant
QDRANT_ENDPOINT=https://your-cluster-id.region.aws.cloud.qdrant.io:6334
QDRANT_API_KEY=YOUR_QDRANT_API_KEY_HERE
QDRANT_COLLECTION_NAME=medical_knowledge
QDRANT_VECTOR_SIZE=3072

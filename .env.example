# ==============================================================================
# TỆP CẤU HÌNH BIẾN MÔI TRƯỜNG CHATBOT_V1 (ENVIRONMENT VARIABLES)
# ==============================================================================
# HƯỚNG DẪN:
# 1. Sao chép tệp này thành `.env` (chạy: cp .env.example .env)
# 2. Điền các khóa API và cấu hình thật vào các vị trí có chữ YOUR_...
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CẤU HÌNH NHÀ CUNG CẤP AI (LLM & EMBEDDINGS)
# ------------------------------------------------------------------------------
# Lựa chọn 1: Dùng Google Gemini 1.5 Flash (Mặc định - 100% MIỄN PHÍ)
# - Lấy key tại: https://aistudio.google.com/
LLM_PROVIDER=gemini
LLM_BASE_URL=https://generativelanguage.googleapis.com
LLM_API_KEY=YOUR_GEMINI_API_KEY_HERE
LLM_MODEL=gemini-3.5-flash-lite
LLM_EMBEDDING_MODEL=gemini-embedding-001

# Lựa chọn 2: Dùng nhà cung cấp tùy chỉnh hoặc trung gian (Ví dụ: 9router, OpenRouter, Local LLM)
# Khi muốn chuyển sang 9router, chỉ cần bỏ dấu comment (#) 4 dòng dưới và điền key của 9router:
# LLM_PROVIDER=custom_openai
# LLM_BASE_URL=https://api.9router.com/v1
# LLM_API_KEY=YOUR_9ROUTER_API_KEY_HERE
# LLM_MODEL=gemini-1.5-flash

# ------------------------------------------------------------------------------
# 2. CẤU HÌNH TÀI KHOẢN ADMIN (QUẢN LÝ TÀI LIỆU Y VĂN)
# ------------------------------------------------------------------------------
# Khóa bí mật dùng để xác thực quyền Admin khi nạp/xóa tài liệu qua API hoặc giao diện
ADMIN_SECRET_KEY=YOUR_ADMIN_SECRET_PASSWORD_HERE

# ------------------------------------------------------------------------------
# 3. CẤU HÌNH GOOGLE FIREBASE (DÀNH CHO FRONTEND CHATBOT.FE)
# ------------------------------------------------------------------------------
# Lấy các thông số này tại: Firebase Console -> Project Settings -> Your apps -> Web App
VITE_FIREBASE_API_KEY=YOUR_FIREBASE_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=YOUR_PROJECT_ID.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=YOUR_PROJECT_ID
VITE_FIREBASE_STORAGE_BUCKET=YOUR_PROJECT_ID.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=YOUR_MESSAGING_SENDER_ID
VITE_FIREBASE_APP_ID=YOUR_APP_ID
VITE_FIREBASE_MEASUREMENT_ID=YOUR_MEASUREMENT_ID

# ------------------------------------------------------------------------------
# 4. CẤU HÌNH HỆ THỐNG MÁY CHỦ (SERVER)
# ------------------------------------------------------------------------------
PORT=10000
ASPNETCORE_ENVIRONMENT=Development
STORAGE_DOCUMENTS_PATH=src/Chatbot.Be/data/documents
STORAGE_DB_PATH=src/Chatbot.Be/data/index/knowledge.db
